# kazumiweb — KazumiWeb on Oracle Cloud Always Free (Ubuntu 24.04, ARM)
# Installed by deploy/oracle/deploy.sh to /etc/systemd/system/kazumiweb.service
[Unit]
Description=KazumiWeb (kazumi_web binary + subs proxy sidecar)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kazumiweb
Environment=PORT=10000
Environment=KAZUMI_WEB_HEADLESS=1
ExecStart=/opt/kazumiweb/run.sh
Restart=always
RestartSec=10
# The binary is a Flutter desktop app; it needs a display (xvfb) and
# enough file handles for HLS segment fetching.
LimitNOFILE=65536
# Keep stdout/stderr in the journal: journalctl -u kazumiweb -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
